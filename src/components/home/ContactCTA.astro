---
import Container from '../ui/Container.astro';
import GoogleMapsEmbed from '../GoogleMapsEmbed.astro';
import { Icon } from 'astro-icon/components';
---

<section class="py-16 bg-slate-50">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <!-- Info -->
      <div>
        <span class="text-accent font-semibold text-sm uppercase tracking-wider">Visítanos</span>
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-primary mt-2 mb-6">
          Estamos en el corazón de Zona 9
        </h2>

        <div class="space-y-5">
          <!-- Dirección -->
          <div class="flex gap-4">
            <div
              class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0 mt-0.5"
            >
              <Icon name="lucide:map-pin" class="w-5 h-5 text-primary" />
            </div>
            <div>
              <p class="font-semibold text-primary">Dirección</p>
              <p class="text-neutral text-sm">
                2ª Calle 2-73, Zona 9<br />Ciudad de Guatemala, Guatemala
              </p>
              <a
                href="https://maps.google.com/?q=Ferreteria+Dismafer+2a+Calle+2-73+Zona+9+Guatemala"
                target="_blank"
                class="text-accent text-sm font-semibold hover:underline"
              >
                Ver en Google Maps →
              </a>
            </div>
          </div>

          <!-- Horarios -->
          <div class="flex gap-4">
            <div
              class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0 mt-0.5"
            >
              <Icon name="lucide:clock" class="w-5 h-5 text-primary" />
            </div>
            <div>
              <p class="font-semibold text-primary">Horarios</p>
              <p class="text-neutral text-sm">Lunes – Viernes: 8:00 – 17:00</p>
              <p class="text-neutral text-sm">Sábado: 8:00 – 14:00</p>
              <p class="text-neutral text-sm">Domingo: Cerrado</p>
            </div>
          </div>

          <!-- Teléfono -->
          <div class="flex gap-4">
            <div
              class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0 mt-0.5"
            >
              <Icon name="lucide:phone" class="w-5 h-5 text-primary" />
            </div>
            <div>
              <p class="font-semibold text-primary">Teléfono</p>
              <a href="tel:+50223390468" class="text-accent font-semibold hover:underline"
                >(502) 2339-0468</a
              >
            </div>
          </div>
        </div>

        <!-- CTA WhatsApp -->
        <a
          href="https://wa.me/50258330848?text=Hola%2C%20me%20interesa%20informaci%C3%B3n%20sobre%20sus%20productos"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center gap-3 bg-green-500 hover:bg-green-600 text-white font-bold px-8 py-4 rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 no-underline"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"
            ><path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            ></path></svg
          >
          Escríbenos por WhatsApp
        </a>
      </div>

      <!-- Google Maps Embed -->
      <GoogleMapsEmbed height="h-80 lg:h-96" />
    </div>
  </Container>
</section>
