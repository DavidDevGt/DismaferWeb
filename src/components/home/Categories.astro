---
import { categories } from '../../data/index';
import Container from '../ui/Container.astro';
import { Icon } from 'astro-icon/components';

const categoryIcons: Record<string, string> = {
  'herramienta-manual': 'lucide:wrench',
  'herramienta-electrica': 'lucide:drill',
  'tuberia-pvc': 'lucide:cylinder',
  'seguridad-industrial': 'lucide:hard-hat',
  pinturas: 'lucide:paint-bucket',
  'materiales-construccion': 'lucide:layers',
};
---

<section class="py-16 bg-slate-50">
  <Container>
    <div class="text-center mb-12">
      <span class="text-accent font-semibold text-sm uppercase tracking-wider">Catálogo</span>
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-primary mt-2">
        Todo lo que necesitas
      </h2>
      <p class="text-neutral mt-3 max-w-xl mx-auto">
        Más de 500 productos en 6 categorías principales. Si no lo tenemos, te lo conseguimos.
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      {
        categories.map((cat) => (
          <a
            href={`/productos/${cat.slug}`}
            class="group bg-white rounded-2xl p-6 shadow-sm hover:shadow-lg border border-gray-100 hover:border-accent/30 transition-all duration-300 no-underline flex flex-col gap-4"
          >
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center group-hover:bg-accent group-hover:scale-110 transition-all duration-300">
              <Icon
                name={categoryIcons[cat.slug] ?? 'lucide:wrench'}
                class="w-6 h-6 text-primary group-hover:text-white transition-colors"
              />
            </div>

            <div>
              <h3 class="font-heading font-semibold text-primary text-lg leading-tight group-hover:text-accent transition-colors">
                {cat.name}
              </h3>
              <p class="text-sm text-neutral mt-1 leading-relaxed line-clamp-2">
                {cat.description}
              </p>
            </div>

            <div class="flex items-center gap-1 text-accent text-sm font-semibold mt-auto">
              Ver productos
              <svg
                class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </div>
          </a>
        ))
      }
    </div>
  </Container>
</section>
