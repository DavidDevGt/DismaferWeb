---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'whatsapp' | 'accent' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  target?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  ariaLabel?: string;
}
const {
  variant = 'primary',
  size = 'md',
  href,
  target,
  class: className = '',
  type = 'button',
  disabled = false,
  ariaLabel,
} = Astro.props;

const base =
  'inline-flex items-center justify-center font-semibold rounded-lg transition-all duration-300 cursor-pointer no-underline disabled:opacity-50 disabled:cursor-not-allowed';

const variants = {
  primary: 'bg-accent text-white hover:bg-orange-600 active:scale-95 shadow-md hover:shadow-lg',
  secondary: 'bg-primary text-white hover:bg-blue-900 active:scale-95 shadow-md hover:shadow-lg',
  ghost: 'border-2 border-primary text-primary hover:bg-primary hover:text-white active:scale-95',
  whatsapp: 'bg-green-500 text-white hover:bg-green-600 active:scale-95 shadow-md hover:shadow-lg',
  accent: 'bg-accent/20 text-accent hover:bg-accent/30 active:scale-95',
  danger: 'bg-red-500 text-white hover:bg-red-600 active:scale-95 shadow-md hover:shadow-lg',
};

const sizes = {
  sm: 'px-4 py-2 text-sm gap-1.5',
  md: 'px-6 py-3 text-base gap-2',
  lg: 'px-8 py-4 text-lg gap-2',
};

const classes = `${base} ${variants[variant]} ${sizes[size]} ${className}`;
const Tag = href ? 'a' : 'button';
---

<Tag
  class={classes}
  href={href}
  target={target}
  type={!href ? type : undefined}
  disabled={!href && disabled ? disabled : undefined}
  aria-label={ariaLabel}
>
  <slot />
</Tag>

<style>
  :global() button:focus-visible,
  :global() a:focus-visible {
    outline: 2px solid #f66c26;
    outline-offset: 2px;
  }
</style>
