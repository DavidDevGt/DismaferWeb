---
interface Props {
  height?: string;
}

const { height = 'h-80 lg:h-full' } = Astro.props;
const embedUrl = new URL(
  'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d633.9298450192414!2d-90.52240931775223!3d14.613900819573189!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8589a384903cd29f%3A0x8e03fd8e80e5b008!2sDismafer!5e0!3m2!1ses!2sgt!4v1781217079104!5m2!1ses!2sgt'
);
---

<iframe
  src={embedUrl}
  width="100%"
  height="100%"
  class={`rounded-2xl border-0 shadow-lg ${height}`}
  allowfullscreen=""
  loading="lazy"
  referrerpolicy="no-referrer-when-downgrade"
  title="Ubicación de Ferretería Dismafer en Zona 9, Guatemala">
</iframe>
