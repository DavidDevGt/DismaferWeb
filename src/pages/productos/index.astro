---
import PageLayout from '../../layouts/PageLayout.astro';
import { categories } from '../../data/index';
import Container from '../../components/ui/Container.astro';
import { Icon } from 'astro-icon/components';

const categoryIcons: Record<string, string> = {
  'herramienta-manual': 'lucide:wrench',
  'herramienta-electrica': 'lucide:drill',
  'tuberia-pvc': 'lucide:cylinder',
  'seguridad-industrial': 'lucide:hard-hat',
  pinturas: 'lucide:paint-bucket',
  'materiales-construccion': 'lucide:layers',
};
---

<PageLayout
  title="Productos — Ferretería Dismafer Guatemala"
  description="Catálogo de productos: herramientas manuales y eléctricas, tubería PVC, seguridad industrial, pinturas y materiales de construcción. Zona 9, Guatemala."
>
  <!-- Page header -->
  <div class="bg-primary text-white py-12">
    <Container>
      <nav class="text-sm text-white/60 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white no-underline">Inicio</a>
        <span class="mx-2">/</span>
        <span class="text-white">Productos</span>
      </nav>
      <h1 class="text-3xl sm:text-4xl font-heading font-bold">Nuestros Productos</h1>
      <p class="text-white/80 mt-2 max-w-2xl">
        Más de 500 productos disponibles. Consulta disponibilidad por WhatsApp.
      </p>
    </Container>
  </div>

  <!-- Categories grid -->
  <div class="py-12 bg-slate-50">
    <Container>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          categories.map((cat) => (
            <a
              href={`/productos/${cat.slug}`}
              class="group bg-white rounded-2xl p-8 shadow-sm hover:shadow-lg border border-gray-100 hover:border-accent/30 transition-all duration-300 no-underline"
            >
              <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center group-hover:bg-accent group-hover:scale-110 transition-all duration-300 mb-5">
                <Icon
                  name={categoryIcons[cat.slug] ?? 'lucide:wrench'}
                  class="w-7 h-7 text-primary group-hover:text-white transition-colors"
                />
              </div>
              <h2 class="text-xl font-heading font-bold text-primary mb-2 group-hover:text-accent transition-colors">
                {cat.name}
              </h2>
              <p class="text-neutral text-sm leading-relaxed mb-4">{cat.description}</p>
              <div class="flex items-center gap-1 text-accent text-sm font-semibold">
                Ver productos
                <svg
                  class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </div>
            </a>
          ))
        }
      </div>

      <!-- CTA -->
      <div class="mt-12 text-center bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
        <p class="text-lg font-semibold text-primary mb-2">¿No encuentras lo que buscas?</p>
        <p class="text-neutral mb-6">
          Si no lo tenemos en stock, lo conseguimos. Escríbenos con tu requerimiento.
        </p>
        <a
          href="https://wa.me/50258330848?text=Hola%2C%20busco%20el%20siguiente%20producto%3A%20"
          target="_blank"
          class="inline-flex items-center gap-3 bg-green-500 hover:bg-green-600 text-white font-bold px-8 py-4 rounded-xl shadow-lg hover:shadow-xl transition-all no-underline"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"
            ><path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            ></path></svg
          >
          Consultar por WhatsApp
        </a>
      </div>
    </Container>
  </div>
</PageLayout>
